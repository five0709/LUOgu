{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 编译当前文件",
            "command": "g++.exe",
            "args": [
                "-std=c++14",
                "-O2",
                "-Wall",
                "-Wextra",
                "-fdiagnostics-color=always",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 PATH 中的 GNU G++ 编译当前 C++ 文件。"
        }
    ],
    "version": "2.0.0"
}
